@section Scripts {
    <script>
        (function () {
            // compute age from an ISO date (yyyy-MM-dd or yyyy-MM-ddTHH:mm:ss)
            function computeAgeFromIso(dateStr) {
                if (!dateStr) return '';
                var d = dateStr.split('T')[0];
                var parts = d.split('-');
                if (parts.length < 3) return '';
                var y = parseInt(parts[0], 10);
                var m = parseInt(parts[1], 10) - 1;
                var day = parseInt(parts[2], 10);
                var dob = new Date(y, m, day);
                if (isNaN(dob.getTime())) return '';
                var today = new Date();
                var age = today.getFullYear() - dob.getFullYear();
                var mm = today.getMonth() - dob.getMonth();
                if (mm < 0 || (mm === 0 && today.getDate() < dob.getDate())) age--;
                return age >= 0 ? age : '';
            }

            // Quick search
            const searchBox = document.getElementById('searchBox');
            if (searchBox) {
                searchBox.addEventListener('input', function (e) {
                    const q = (e.target.value || '').toLowerCase().trim();
                    document.querySelectorAll('table tbody tr[data-id]').forEach(tr => {
                        const text = tr.innerText.toLowerCase();
                        tr.style.display = q === '' || text.indexOf(q) !== -1 ? '' : 'none';
                    });
                });
            }

            // helper: fetch JSON by id from Reschedules controller
            async function fetchById(id) {
                try {
                    const url = '@Url.Action("GetById", "Reschedules")' + '?id=' + encodeURIComponent(id);
                    const res = await fetch(url, { credentials: 'same-origin' });
                    if (!res.ok) throw new Error('Server returned ' + res.status);
                    return await res.json();
                } catch (err) {
                    console.error(err);
                    alert('Failed to load record: ' + err.message);
                    return null;
                }
            }

            // Open Update modal and populate fields
            async function openUpdateModal(id) {
                const data = await fetchById(id);
                if (!data) return;

                document.getElementById('Id').value = data.id || '';
                document.getElementById('Name').value = data.name || '';
                document.getElementById('HomeAddress').value = data.homeAddress || '';
                document.getElementById('Date').value = data.date ? data.date.split('T')[0] : '';
                document.getElementById('BirthDay').value = data.birthDay ? data.birthDay.split('T')[0] : '';

                // compute age client-side
                const computedAge = computeAgeFromIso(data.birthDay ? data.birthDay.split('T')[0] : '');
                if (computedAge !== '') document.getElementById('Age').value = computedAge;
                else document.getElementById('Age').value = data.age || '';

                document.getElementById('HomeNumber').value = data.homeNumber || '';
                document.getElementById('Occupation').value = data.occupation || '';
                document.getElementById('MobileNumber').value = data.mobileNumber || '';
                document.getElementById('OfficeAddress').value = data.officeAddress || '';
                document.getElementById('EmailAddress').value = data.emailAddress || '';

                // Only prefill Status if it's not equal to WalkInStatus and not a walk-in token
                var statusValue = (data.status || '').toString().trim();
                var walkInValue = (data.walkInStatus || '').toString().trim();
                var lower = statusValue.toLowerCase();
                if (lower === 'pre-register' || lower === 'registered' || (walkInValue && lower === walkInValue.toLowerCase())) {
                    statusValue = '';
                }
                document.getElementById('Status').value = statusValue;

                document.getElementById('NameOfSpouse').value = data.nameOfSpouse || '';
                document.getElementById('PersonalResponsibleforAccount').value = data.personalResponsibleforAccount || '';
                document.getElementById('Relationship').value = data.relationship || '';
                document.getElementById('PhysicianCare').value = data.physicianCare || '';
                document.getElementById('PhysicianName').value = data.physicianName || '';
                document.getElementById('ContactNumber').value = data.contactNumber || '';
                document.getElementById('AvailableDay').value = data.availableDay || '';
                document.getElementById('AvailableTime').value = data.availableTime || '';

                // show modal
                const modalEl = document.getElementById('updateModal');
                if (modalEl && typeof bootstrap !== 'undefined') new bootstrap.Modal(modalEl).show();
            }

            // Open Details modal and populate fields
            async function openDetailsModal(id) {
                const data = await fetchById(id);
                if (!data) return;

                document.getElementById('detailName').textContent = data.name || '';
                document.getElementById('detailHomeAddress').textContent = data.homeAddress || '';
                document.getElementById('detailDate').textContent = data.date ? data.date.split('T')[0] : '';
                document.getElementById('detailBirthDay').textContent = data.birthDay ? (new Date(data.birthDay)).toLocaleDateString() : '';
                document.getElementById('detailAge').textContent = data.age || computeAgeFromIso(data.birthDay || '') || '';
                document.getElementById('detailHomeNumber').textContent = data.homeNumber || '';
                document.getElementById('detailOccupation').textContent = data.occupation || '';
                document.getElementById('detailMobileNumber').textContent = data.mobileNumber || '';
                document.getElementById('detailOfficeAddress').textContent = data.officeAddress || '';
                document.getElementById('detailEmailAddress').textContent = data.emailAddress || '';
                document.getElementById('detailStatus').textContent = data.status || '';
                document.getElementById('detailWalkInStatus').textContent = data.walkInStatus || '';
                document.getElementById('detailNameOfSpouse').textContent = data.nameOfSpouse || '';
                document.getElementById('detailPersonalResponsibleforAccount').textContent = data.personalResponsibleforAccount || '';
                document.getElementById('detailRelationship').textContent = data.relationship || '';
                document.getElementById('detailPhysicianCare').textContent = data.physicianCare || '';
                document.getElementById('detailPhysicianName').textContent = data.physicianName || '';
                document.getElementById('detailContactNumber').textContent = data.contactNumber || '';
                document.getElementById('detailAvailableDay').textContent = data.availableDay || '';
                document.getElementById('detailAvailableTime').textContent = data.availableTime || '';

                const modalEl = document.getElementById('detailsModal');
                if (modalEl && typeof bootstrap !== 'undefined') new bootstrap.Modal(modalEl).show();
            }

            // Load available dates into reschedule modal
            async function loadAvailableDatesInto(selectEl) {
                try {
                    const url = '@Url.Action("GetAvailableDates","Reschedules")';
                    const res = await fetch(url, { credentials: 'same-origin' });
                    if (!res.ok) throw new Error('Server returned ' + res.status);
                    const data = await res.json();
                    // Expect data to be array [{ value:'2026-01-29', text:'2026-01-29', availableSlots: 3 }, ...]
                    selectEl.innerHTML = '<option value="">Select date...</option>';
                    if (Array.isArray(data)) {
                        data.forEach(item => {
                            const opt = document.createElement('option');
                            opt.value = item.value || item.text;
                            opt.textContent = item.text + (item.availableSlots ? ` (${item.availableSlots} slots)` : '');
                            selectEl.appendChild(opt);
                        });
                    }
                } catch (err) {
                    console.error(err);
                    // leave default option
                }
            }

            // Open Reschedule modal
            async function openRescheduleModal(id, name) {
                document.getElementById('reschedulePersonId').value = id;
                document.getElementById('reschedulePersonName').textContent = name || '';

                // clear previous
                const dateSel = document.getElementById('availableDate');
                const timeSel = document.getElementById('availableTime');
                if (dateSel) dateSel.innerHTML = '<option value="">Select date...</option>';
                if (timeSel) timeSel.innerHTML = '<option value="">Select time...</option>';

                if (dateSel) await loadAvailableDatesInto(dateSel);

                const modalEl = document.getElementById('rescheduleModal');
                if (modalEl && typeof bootstrap !== 'undefined') new bootstrap.Modal(modalEl).show();
            }

            // When user selects date in Reschedule modal, load times
            document.addEventListener('change', async function (e) {
                if (e.target && e.target.id === 'availableDate') {
                    const selected = e.target.value;
                    const timeSel = document.getElementById('availableTime');
                    if (!selected) {
                        timeSel.innerHTML = '<option value="">Select time...</option>';
                        timeSel.disabled = true;
                        return;
                    }
                    try {
                        const url = '@Url.Action("GetAvailableTimeSlots","Reschedules")' + '?date=' + encodeURIComponent(selected);
                        const res = await fetch(url, { credentials: 'same-origin' });
                        if (!res.ok) throw new Error('Server returned ' + res.status);
                        const data = await res.json();
                        timeSel.innerHTML = '<option value="">Select time...</option>';
                        if (Array.isArray(data) && data.length > 0) {
                            data.forEach(it => {
                                const opt = document.createElement('option');
                                opt.value = it.value || it.text;
                                opt.textContent = it.text;
                                timeSel.appendChild(opt);
                            });
                            timeSel.disabled = false;
                        } else {
                            timeSel.innerHTML = '<option value="">No available times</option>';
                            timeSel.disabled = true;
                        }
                    } catch (err) {
                        console.error(err);
                        timeSel.innerHTML = '<option value="">Error loading</option>';
                        timeSel.disabled = true;
                    }
                }
            });

            // Wire action links (delegated)
            document.addEventListener('click', function (e) {
                const upd = e.target.closest('.action-update');
                if (upd) {
                    e.preventDefault();
                    const id = upd.getAttribute('data-id');
                    if (id) openUpdateModal(id);
                    return;
                }
                const det = e.target.closest('.action-details');
                if (det) {
                    e.preventDefault();
                    const id = det.getAttribute('data-id');
                    if (id) openDetailsModal(id);
                    return;
                }
                const res = e.target.closest('.action-reschedule');
                if (res) {
                    e.preventDefault();
                    const id = res.getAttribute('data-id');
                    // get person name from row cell
                    const row = res.closest('tr');
                    const name = row ? (row.querySelector('td:nth-child(2)')?.innerText || '') : '';
                    if (id) openRescheduleModal(id, name);
                    return;
                }
            });

            // When BirthDay changes in Update modal, recompute age
            document.getElementById('BirthDay')?.addEventListener('change', function (e) {
                const val = e.target.value;
                const computed = computeAgeFromIso(val);
                if (computed !== '') document.getElementById('Age').value = computed;
            });

            // Wire update form submit (existing endpoint)
            document.getElementById('updateForm')?.addEventListener('submit', async function (ev) {
                ev.preventDefault();
                const form = ev.target;
                const data = new FormData(form);
                try {
                    const res = await fetch('@Url.Action("Update","Reschedules")', {
                        method: 'POST',
                        body: data,
                        credentials: 'same-origin'
                    });
                    if (!res.ok) throw new Error('Server returned ' + res.status);
                    // reload page to reflect changes
                    location.reload();
                } catch (err) {
                    console.error(err);
                    alert('Error saving update: ' + err.message);
                }
            });

            // Handle confirm reschedule
            document.getElementById('confirmReschedule')?.addEventListener('click', async function () {
                const personId = document.getElementById('reschedulePersonId').value;
                const newDate = document.getElementById('availableDate').value;
                const newTime = document.getElementById('availableTime').value;
                if (!personId || !newDate || !newTime) return alert('Please select date and time.');
                try {
                    const res = await fetch('@Url.Action("RescheduleAppointment","Reschedules")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'same-origin',
                        body: JSON.stringify({ personId, newDate, newTime })
                    });
                    const json = await res.json();
                    if (!json.success) return alert('Reschedule failed: ' + (json.message || 'unknown'));
                    location.reload();
                } catch (err) {
                    console.error(err);
                    alert('Error rescheduling: ' + err.message);
                }
            });

        })();
    </script>
}
