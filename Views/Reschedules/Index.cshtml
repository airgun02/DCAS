@model IEnumerable<DCAS.Models.PersonInfo>

@{
    ViewData["Title"] = "Person Info Index";
}
<style>
    /* Layout tweaks for a cleaner, compact Reschedules list */
    .card-header {
        padding: 12px 18px;
        background-color: #7A4B00;
        border-radius: 6px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .card-header h2 {
        margin: 0;
        color: white;
        font-weight: 600;
        font-size: 1.25rem;
        display:flex;
        align-items:center;
        gap:0.5rem;
    }

    .fas{
        color:white;
    }

    .modal-header{
        background-color: #7A4B00;
    }

    .modal-title{
     color:white;
    }
    /* Compact table spacing */
    .table-compact th,
    .table-compact td {
        padding: .55rem .7rem;
        vertical-align: middle;
        border-top: 1px solid #e9e9e9;
        white-space: nowrap;
    }

    /* Slightly lighter header */
    .table-compact thead th {
        background: #DACBAE;
        border-bottom: 2px solid #eee;
        color: #333;
    }

    /* alternate row shading for readability */
    .table-compact tbody tr:nth-child(odd) {
        background: #ffffff;
    }
    .table-compact tbody tr:nth-child(even) {
        background: #fbfbfb;
    }

    /* badge */
    .status-badge { font-size: .78rem; padding: .28rem .55rem; border-radius: .375rem; }

    /* actions dropdown small */
    .actions-dropdown .dropdown-toggle {
        padding: .3rem .5rem;
        font-size: .85rem;
    }
    .actions-dropdown .dropdown-menu { min-width: 10.5rem; }

    /* keep table container responsive */
    .table-responsive { overflow-x: auto; max-width: 100%; }

    /* place search box inside header right area */
    .search-box {
        display:flex;
        align-items:center;
        gap:8px;
    }
    .search-box input {
        width: 320px;
        max-width: 40vw;
    }

    @@media (max-width: 900px) {
        .search-box input { width: 180px; max-width: 45vw; }
        .table-compact th:nth-child(6),
        .table-compact td:nth-child(6) { display:none; } /* hide email on small screens */
    }

    /* custom buttons for Reschedules page */
    .btn-save {
      background: #0d6efd; /* your hex */
      border-color: #0d6efd;
      color: #fff;
    }
    .btn-save:hover { background: #0b5ed7; border-color: #0a58ca; }

    .btn-reschedule {
      background: #198754; /* your hex */
      border-color: #198754;
      color: #fff;
    }
    .btn-reschedule:hover { background: #157347; border-color: #146c43; }
</style>

<div class="card">
    <div class="card-header">
        <h2><i class="fas fa-edit"></i> Update Information / Reschedules</h2>

        <div class="search-box">
            <input id="searchBox" name="q" value="@(ViewBag.Query ?? "")"
                   class="form-control form-control-sm" placeholder="Search name, mobile or email" />
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-compact mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:1%">#</th>
                        <th style="min-width:160px">Name</th>
                        <th style="width:110px">Date Of Visit</th>
                        <th style="width:60px">Age</th>
                        <th style="min-width:120px">Mobile</th>
                        <th style="min-width:160px">Email</th>
                        <th style="width:110px">Status</th>
                        <th style="min-width:140px">Schedule</th>
                        <th style="width:90px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var idx = 1;
                        foreach (var item in Model)
                        {
                            // Keep marital Status empty when it equals WalkInStatus (project rule)
                            var displayStatus = "";
                            if (!string.IsNullOrWhiteSpace(item.Status))
                            {
                                var s = item.Status.Trim();
                                var walkin = item.WalkInStatus?.Trim() ?? "";
                                if (!s.Equals("Pre-register", StringComparison.OrdinalIgnoreCase)
                                    && !s.Equals("Registered", StringComparison.OrdinalIgnoreCase)
                                    && !s.Equals(walkin, StringComparison.OrdinalIgnoreCase))
                                {
                                    displayStatus = s;
                                }
                            }

                            var scheduleText = string.IsNullOrWhiteSpace(item.AvailableDay) ? "" : $"{item.AvailableDay}";
                            if (!string.IsNullOrWhiteSpace(item.AvailableTime)) scheduleText += (scheduleText == "" ? "" : " ") + item.AvailableTime;
                        <tr data-id="@item.Id">
                            <td>@idx</td>
                            <td><strong>@(item.Name ?? "\u2014")</strong></td>
                            <td>@(item.Date?.ToString("MM-dd-yyyy") ?? "\u2014")</td>
                            <td>@(item.Age ?? 0)</td>
                            <td>@(item.MobileNumber ?? "\u2014")</td>
                            <td>@(item.EmailAddress ?? "\u2014")</td>
                            <td>@(string.IsNullOrWhiteSpace(displayStatus) ? "\u2014" : displayStatus)</td>
                            <td>@(string.IsNullOrWhiteSpace(scheduleText) ? "\u2014" : scheduleText)</td>
                            <td>
                                <div class="dropdown actions-dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="actionsMenu@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="actionsMenu@item.Id">
                                        <li><a class="dropdown-item action-update" href="#" data-id="@item.Id">Update</a></li>
                                        <li><a class="dropdown-item action-details" href="#" data-id="@item.Id">View Details</a></li>
                                        <li><a class="dropdown-item action-reschedule" href="#" data-id="@item.Id">Reschedule</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" href="@Url.Action("PatientHistory", "Payments", new { personId = item.Id })">Patient History</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                            idx++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No registered clients found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" role="dialog" aria-labelledby="updateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <form id="updateForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel">Update Person Info</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <input type="hidden" id="Id" name="Id" />

                    <div class="col-md-6">
                        <label for="Name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" required />
                    </div>
                    <div class="col-md-6">
                        <label for="HomeAddress" class="form-label">Home Address</label>
                        <input type="text" class="form-control" id="HomeAddress" name="HomeAddress" />
                    </div>
                    <div class="col-md-6">
                        <label for="Date" class="form-label">Date Of Visit</label>
                        <input type="date" class="form-control" id="Date" name="Date" readonly/>
                    </div>
                    <div class="col-md-6">
                        <label for="BirthDay" class="form-label">Birthday</label>
                        <input type="date" class="form-control" id="BirthDay" name="BirthDay" />
                    </div>
                    <div class="col-md-6">
                        <label for="Age" class="form-label">Age</label>
                        <input type="number" class="form-control" id="Age" name="Age" />
                    </div>
                    <div class="col-md-6">
                        <label for="HomeNumber" class="form-label">Home Number</label>
                        <input type="text" class="form-control" id="HomeNumber" name="HomeNumber" />
                    </div>
                    <div class="col-md-6">
                        <label for="Occupation" class="form-label">Occupation</label>
                        <input type="text" class="form-control" id="Occupation" name="Occupation" />
                    </div>
                    <div class="col-md-6">
                        <label for="MobileNumber" class="form-label">Mobile Number</label>
                        <input type="text" class="form-control" id="MobileNumber" name="MobileNumber"
                               maxlength="11" minlength="11" pattern="\d{11}" inputmode="numeric" />
                    </div>
                    <div class="col-md-6">
                        <label for="OfficeAddress" class="form-label">Office Address</label>
                        <input type="text" class="form-control" id="OfficeAddress" name="OfficeAddress" />
                    </div>
                    <div class="col-md-6">
                        <label for="EmailAddress" class="form-label">Email Address</label>
                        <input type="email" class="form-control" id="EmailAddress" name="EmailAddress" />
                    </div>
                    <div class="col-md-6">
                        <label for="Status" class="form-label">Status</label>
                        <select class="form-select" id="Status" name="Status">
                            <option value="">-- Select civil status --</option>
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                            <option value="Divorced">Divorced</option>
                            <option value="Widowed">Widowed</option>
                        </select>
                    </div>

                    <!-- WalkInStatus removed from modal (invisible so DB value is preserved) -->

                    <div class="col-md-6">
                        <label for="NameOfSpouse" class="form-label">Name of Spouse</label>
                        <input type="text" class="form-control" id="NameOfSpouse" name="NameOfSpouse" />
                    </div>
                    <div class="col-md-6">
                        <label for="PersonalResponsibleforAccount" class="form-label">Responsible for Account</label>
                        <input type="text" class="form-control" id="PersonalResponsibleforAccount" name="PersonalResponsibleforAccount" />
                    </div>
                    <div class="col-md-6">
                        <label for="Relationship" class="form-label">Relationship</label>
                        <input type="text" class="form-control" id="Relationship" name="Relationship" />
                    </div>
                    <div class="col-md-6">
                        <label for="PhysicianCare" class="form-label">Physician Care</label>
                        <input type="text" class="form-control" id="PhysicianCare" name="PhysicianCare" />
                    </div>
                    <div class="col-md-6">
                        <label for="PhysicianName" class="form-label">Physician Name</label>
                        <input type="text" class="form-control" id="PhysicianName" name="PhysicianName" />
                    </div>
                    <div class="col-md-6">
                        <label for="ContactNumber" class="form-label">Physician Contact Number</label>
                        <input type="text" class="form-control" id="ContactNumber" name="ContactNumber" />
                    </div>
                    <div class="col-md-6">
                        <label for="AvailableDay" class="form-label">Available Day</label>
                        <input type="text" class="form-control" id="AvailableDay" name="AvailableDay" readonly/>
                    </div>
                    <div class="col-md-6">
                        <label for="AvailableTime" class="form-label">Available Time</label>
                        <input type="text" class="form-control" id="AvailableTime" name="AvailableTime" readonly />
                    </div>
                </div>
                <!-- Update modal footer -->
                <div class="modal-footer">
                    <button type="submit" class="btn btn-save">Save changes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

